@page
@model RagNotes.Web.Pages.Documents.IndexModel
@using RagNotes.Web.Models
@{
    ViewData["Title"] = "Documents";
}

<h1>Upload Document</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<form method="post"
      enctype="multipart/form-data"
      class="mb-4"
      data-busy-label="Uploading and embedding…">
    <div class="mb-3">
        <label for="file" class="form-label">Choose File</label>
        <input type="file"
               class="form-control"
               id="file"
               name="file"
               accept=".txt,.md"
               required />
    </div>
    <div class="mb-3">
        <label asp-for="EmbeddingModel" class="form-label"></label>
        <select asp-for="EmbeddingModel" class="form-select">
            @foreach (var embeddingModel in Model.EmbeddingModels)
            {
                <option value="@embeddingModel.Id">
                    @embeddingModel.Id@(embeddingModel.VectorSize > 0 ? $" ({embeddingModel.VectorSize}d)" : "")
                </option>
            }
        </select>
        <div class="form-text">Vectors are stored in a separate Qdrant collection per embedding model.</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="maxTokens" class="form-label">Max tokens</label>
            <input type="number"
                   class="form-control"
                   id="maxTokens"
                   name="maxTokens"
                   value="@ChunkOptions.DefaultMaxTokens"
                   min="@ChunkOptions.MinMaxTokens"
                   max="@ChunkOptions.MaxMaxTokens"
                   required />
            <div class="form-text">Hard cap for each chunk (32–2048).</div>
        </div>
        <div class="col-md-4">
            <label for="overlapPercent" class="form-label">Overlap percent</label>
            <input type="number"
                   class="form-control"
                   id="overlapPercent"
                   name="overlapPercent"
                   value="@ChunkOptions.DefaultOverlapPercent"
                   min="@ChunkOptions.MinOverlapPercent"
                   max="@ChunkOptions.MaxOverlapPercent"
                   required />
            <div class="form-text">Share of the cap repeated on the next chunk (0–50).</div>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="preferSentences"
                       name="preferSentences"
                       value="true"
                       checked />
                <label class="form-check-label" for="preferSentences">Keep sentences together</label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>
<p class="text-muted d-none" data-busy-status aria-live="polite"></p>

@if (Model.Documents.Count > 0 && Model.EmbeddingModels.Count > 0)
{
    <h2>Index missing documents</h2>
    <p class="text-muted">
        Embed every uploaded document that is not yet in the selected model’s collection.
        Existing indexes for other models are left alone.
    </p>
    <form method="post"
          asp-page-handler="IndexMissing"
          class="row g-2 align-items-end mb-4"
          data-busy-label="Indexing documents…">
        <div class="col-md-6">
            <label asp-for="BulkEmbeddingModel" class="form-label"></label>
            <select asp-for="BulkEmbeddingModel" class="form-select">
                @foreach (var embeddingModel in Model.EmbeddingModels)
                {
                    <option value="@embeddingModel.Id">
                        @embeddingModel.Id@(embeddingModel.VectorSize > 0 ? $" ({embeddingModel.VectorSize}d)" : "")
                    </option>
                }
            </select>
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-outline-primary">Index missing documents</button>
        </div>
    </form>
    <p class="text-muted d-none" data-busy-status aria-live="polite"></p>
}

<h2>Uploaded Documents</h2>

@if (Model.Documents.Count == 0)
{
    <p>No documents yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>File name</th>
                <th>Chunking</th>
                <th>Embeddings</th>
                <th>Uploaded</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var doc in Model.Documents)
        {
            <tr>
                <td>
                    <a asp-page="/Documents/Details" asp-route-id="@doc.Id">@doc.FileName</a>
                </td>
                <td>@doc.ChunkOptions.Summary</td>
                <td>
                    @if (doc.EmbeddingModels.Count == 0)
                    {
                        <span class="text-muted">None</span>
                    }
                    else
                    {
                        @string.Join(", ", doc.EmbeddingModels)
                    }
                </td>
                <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="id" value="@doc.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete this document?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
