@page "{id:int}"
@model RagNotes.Web.Pages.Documents.DetailsModel
@using RagNotes.Web.Models
@{
    ViewData["Title"] = Model.Document.FileName;
    var rangeStart = Model.TotalChunks == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var rangeEnd = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalChunks);
}

<p>
    <a asp-page="/Documents/Index">&larr; Back to documents</a>
</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<h1>@Model.Document.FileName</h1>
<p class="text-muted">
    Uploaded @Model.Document.CreatedAt.ToLocalTime().ToString("g")
    · @Model.Document.ChunkOptions.Summary
</p>

<pre class="border p-3 bg-light" style="white-space: pre-wrap;">@Model.DisplayContent@if (Model.ContentIsTruncated && !Model.ShowFullContent){<text>…</text>}</pre>
@if (Model.ContentIsTruncated)
{
    <p class="mt-2 mb-0">
        @if (Model.ShowFullContent)
        {
            <a asp-page="/Documents/Details"
               asp-route-id="@Model.Document.Id"
               asp-route-pageNumber="@Model.PageNumber"
               asp-route-showFullContent="false">Show less</a>
            <span class="text-muted"> · @Model.Document.Content.Length.ToString("N0") characters</span>
        }
        else
        {
            <a asp-page="/Documents/Details"
               asp-route-id="@Model.Document.Id"
               asp-route-pageNumber="@Model.PageNumber"
               asp-route-showFullContent="true">Show full text</a>
            <span class="text-muted"> · showing first 2,000 of @Model.Document.Content.Length.ToString("N0") characters</span>
        }
    </p>
}

<h2 class="mt-4">Embedding indexes</h2>
<p class="text-muted">
    Each embedding model uses its own Qdrant collection. Indexing into another model
    does not remove existing indexes.
</p>

@if (Model.Indexes.Count == 0)
{
    <p class="text-muted">Not indexed in any embedding model yet.</p>
}
else
{
    <table class="table table-sm mb-3">
        <thead>
            <tr>
                <th>Model</th>
                <th>Chunks</th>
                <th>Indexed</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var index in Model.Indexes)
        {
            <tr>
                <td>@index.EmbeddingModel</td>
                <td>@index.ChunkCount</td>
                <td>@index.IndexedAt.ToLocalTime().ToString("g")</td>
                <td>
                    <form method="post" asp-page-handler="RemoveFromModel" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Document.Id" />
                        <input type="hidden" name="embeddingModel" value="@index.EmbeddingModel" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Remove this document from @index.EmbeddingModel?');">
                            Remove
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.MissingEmbeddingModels.Count > 0)
{
    <form method="post" asp-page-handler="IndexIntoModel" class="row g-2 align-items-end mb-4">
        <input type="hidden" name="id" value="@Model.Document.Id" />
        <div class="col-md-6">
            <label asp-for="EmbeddingModel" class="form-label"></label>
            <select asp-for="EmbeddingModel" class="form-select">
                @foreach (var embeddingModel in Model.MissingEmbeddingModels)
                {
                    <option value="@embeddingModel.Id">
                        @embeddingModel.Id@(embeddingModel.VectorSize > 0 ? $" ({embeddingModel.VectorSize}d)" : "")
                    </option>
                }
            </select>
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-outline-primary">Index into this model</button>
        </div>
    </form>
}

<h2 class="mt-4">Chunking</h2>
<p class="text-muted">
    Saving reindexes this document in every embedding model it is already attached to.
</p>
<form method="post" asp-page-handler="Reindex" class="mb-4">
    <input type="hidden" name="id" value="@Model.Document.Id" />
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="maxTokens" class="form-label">Max tokens</label>
            <input type="number"
                   class="form-control"
                   id="maxTokens"
                   name="maxTokens"
                   value="@Model.Document.MaxTokens"
                   min="@ChunkOptions.MinMaxTokens"
                   max="@ChunkOptions.MaxMaxTokens"
                   required />
            <div class="form-text">Hard cap for each chunk (32–2048).</div>
        </div>
        <div class="col-md-4">
            <label for="overlapPercent" class="form-label">Overlap percent</label>
            <input type="number"
                   class="form-control"
                   id="overlapPercent"
                   name="overlapPercent"
                   value="@Model.Document.OverlapPercent"
                   min="@ChunkOptions.MinOverlapPercent"
                   max="@ChunkOptions.MaxOverlapPercent"
                   required />
            <div class="form-text">Share of the cap repeated on the next chunk (0–50).</div>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="preferSentences"
                       name="preferSentences"
                       value="true"
                       @(Model.Document.PreferSentences ? "checked" : null) />
                <label class="form-check-label" for="preferSentences">Keep sentences together</label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save and reindex</button>
</form>

<h2 class="mt-4">
    Chunks
    @if (Model.TotalChunks == 0)
    {
        <text>(0)</text>
    }
    else
    {
        <text>(@rangeStart–@rangeEnd of @Model.TotalChunks)</text>
    }
</h2>
<p class="text-muted">
    Vectors for these chunks are stored in each attached embedding model’s Qdrant collection.
</p>

@if (Model.TotalChunks == 0)
{
    <p class="text-muted">No chunks produced.</p>
}
else
{
    <div class="vstack gap-2">
    @foreach (var chunk in Model.Chunks)
    {
        <div class="border p-3 bg-light">
            <div class="text-muted small mb-1">
                Chunk @chunk.ChunkIndex
            </div>
            <pre class="mb-0" style="white-space: pre-wrap;">@chunk.Text</pre>
        </div>
    }
    </div>

    @if (Model.TotalPages > 1)
    {
        var windowStart = Math.Max(1, Model.PageNumber - 2);
        var windowEnd = Math.Min(Model.TotalPages, Model.PageNumber + 2);

        <nav class="mt-4" aria-label="Chunk pages">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                    <a class="page-link"
                       asp-page="/Documents/Details"
                       asp-route-id="@Model.Document.Id"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-showFullContent="@Model.ShowFullContent">Previous</a>
                </li>
                @if (windowStart > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Documents/Details"
                           asp-route-id="@Model.Document.Id"
                           asp-route-pageNumber="1"
                           asp-route-showFullContent="@Model.ShowFullContent">1</a>
                    </li>
                    @if (windowStart > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }
                @for (var p = windowStart; p <= windowEnd; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : null)">
                        <a class="page-link"
                           asp-page="/Documents/Details"
                           asp-route-id="@Model.Document.Id"
                           asp-route-pageNumber="@p"
                           asp-route-showFullContent="@Model.ShowFullContent">@p</a>
                    </li>
                }
                @if (windowEnd < Model.TotalPages)
                {
                    @if (windowEnd < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Documents/Details"
                           asp-route-id="@Model.Document.Id"
                           asp-route-pageNumber="@Model.TotalPages"
                           asp-route-showFullContent="@Model.ShowFullContent">@Model.TotalPages</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                    <a class="page-link"
                       asp-page="/Documents/Details"
                       asp-route-id="@Model.Document.Id"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-showFullContent="@Model.ShowFullContent">Next</a>
                </li>
            </ul>
        </nav>
    }
}
