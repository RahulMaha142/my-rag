@page "{id:int}"
@model RagNotes.Web.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = Model.Document.FileName;
}

<p>
    <a asp-page="./Index">&larr; Back to documents</a>
</p>

<h1>@Model.Document.FileName</h1>
<p class="text-muted">
    Uploaded @Model.Document.CreatedAt.ToLocalTime().ToString("g")
</p>

<pre class="border p-3 bg-light" style="white-space: pre-wrap;">@Model.Document.Content</pre>