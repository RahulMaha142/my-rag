@page "{id:int}"
@model RagNotes.Web.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = Model.Document.FileName;
    var rangeStart = Model.TotalChunks == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var rangeEnd = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalChunks);
}

<p>
    <a asp-page="/Documents/Index">&larr; Back to documents</a>
</p>

<h1>@Model.Document.FileName</h1>
<p class="text-muted">
    Uploaded @Model.Document.CreatedAt.ToLocalTime().ToString("g")
</p>

<pre class="border p-3 bg-light" style="white-space: pre-wrap;">@Model.DisplayContent@if (Model.ContentIsTruncated && !Model.ShowFullContent){<text>…</text>}</pre>
@if (Model.ContentIsTruncated)
{
    <p class="mt-2 mb-0">
        @if (Model.ShowFullContent)
        {
            <a asp-page="/Documents/Details"
               asp-route-id="@Model.Document.Id"
               asp-route-pageNumber="@Model.PageNumber"
               asp-route-showFullContent="false">Show less</a>
            <span class="text-muted"> · @Model.Document.Content.Length.ToString("N0") characters</span>
        }
        else
        {
            <a asp-page="/Documents/Details"
               asp-route-id="@Model.Document.Id"
               asp-route-pageNumber="@Model.PageNumber"
               asp-route-showFullContent="true">Show full text</a>
            <span class="text-muted"> · showing first 2,000 of @Model.Document.Content.Length.ToString("N0") characters</span>
        }
    </p>
}

<h2 class="mt-4">
    Chunks
    @if (Model.TotalChunks == 0)
    {
        <text>(0)</text>
    }
    else
    {
        <text>(@rangeStart–@rangeEnd of @Model.TotalChunks)</text>
    }
</h2>
<p class="text-muted">
    Vectors for these chunks are stored in Qdrant.
</p>

@if (Model.TotalChunks == 0)
{
    <p class="text-muted">No chunks produced.</p>
}
else
{
    <div class="vstack gap-2">
    @foreach (var chunk in Model.Chunks)
    {
        <div class="border p-3 bg-light">
            <div class="text-muted small mb-1">
                Chunk @chunk.ChunkIndex
            </div>
            <pre class="mb-0" style="white-space: pre-wrap;">@chunk.Text</pre>
        </div>
    }
    </div>

    @if (Model.TotalPages > 1)
    {
        var windowStart = Math.Max(1, Model.PageNumber - 2);
        var windowEnd = Math.Min(Model.TotalPages, Model.PageNumber + 2);

        <nav class="mt-4" aria-label="Chunk pages">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                    <a class="page-link"
                       asp-page="/Documents/Details"
                       asp-route-id="@Model.Document.Id"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-showFullContent="@Model.ShowFullContent">Previous</a>
                </li>
                @if (windowStart > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Documents/Details"
                           asp-route-id="@Model.Document.Id"
                           asp-route-pageNumber="1"
                           asp-route-showFullContent="@Model.ShowFullContent">1</a>
                    </li>
                    @if (windowStart > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }
                @for (var p = windowStart; p <= windowEnd; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : null)">
                        <a class="page-link"
                           asp-page="/Documents/Details"
                           asp-route-id="@Model.Document.Id"
                           asp-route-pageNumber="@p"
                           asp-route-showFullContent="@Model.ShowFullContent">@p</a>
                    </li>
                }
                @if (windowEnd < Model.TotalPages)
                {
                    @if (windowEnd < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Documents/Details"
                           asp-route-id="@Model.Document.Id"
                           asp-route-pageNumber="@Model.TotalPages"
                           asp-route-showFullContent="@Model.ShowFullContent">@Model.TotalPages</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                    <a class="page-link"
                       asp-page="/Documents/Details"
                       asp-route-id="@Model.Document.Id"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-showFullContent="@Model.ShowFullContent">Next</a>
                </li>
            </ul>
        </nav>
    }
}
